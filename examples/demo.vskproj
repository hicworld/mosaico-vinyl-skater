  "lyrics": {
    "version": 1,
    "sample_rate": 16000,
    "source": "lrc",
    "lines": [
      {
        "start_sample": 0,
        "end_sample": 32000,
        "text": "黑胶上的小舞台"
      },
      {
        "start_sample": 32000,
        "end_sample": 64000,
        "text": "脚步跟着鼓点出发"
      },
      {
        "start_sample": 64000,
        "end_sample": 96000,
        "text": "沿着弧线转个弯"
      },
      {
        "start_sample": 96000,
        "end_sample": 128000,
        "text": "跃起，再轻轻落下"
      },
      {
        "start_sample": 128000,
        "end_sample": 160000,
        "text": "场景随时间切换"
      },
      {
        "start_sample": 160000,
        "end_sample": 192000,
        "text": "星光留在脚边"
      },
      {
        "start_sample": 192000,
        "end_sample": 224000,
        "text": "把这一段编排保存"
      },
      {
        "start_sample": 224000,
        "end_sample": 256000,
        "text": "再导出一段自己的动画"
      }
    ],
    "notes": [
      "歌词按 LRC 句首时间显示；带时间空行清屏，普通行显示到下一句开始，末句无结束标记时显示到歌曲结束，不表示逐字对齐。"
    ]
  },
  "preview_show_lyrics": true,
